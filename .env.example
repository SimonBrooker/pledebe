# pledebe configuration. Copy to .env and edit.
#
# Only the first two are required. Everything else has a sensible default and is
# shown here commented out, with that default.

# ─── Required ────────────────────────────────────────────────────────────────

# Your Plex config directory — the one containing "Plug-in Support".
# pledebe searches for the database rather than assuming a layout, so pointing
# at a parent directory also works.
#
#   hotio                 /mnt/user/appdata/plex
#   linuxserver, plexinc  /mnt/user/appdata/plex/Library/Application Support/Plex Media Server
#   binhex                /mnt/user/appdata/binhex-plex/Plex Media Server
PLEX_CONFIG=/mnt/user/appdata/plex

# Plex's own SQLite build, extracted once. The WHOLE directory is needed —
# "Plex SQLite" will not run without its siblings.
#
#   docker cp plex:/usr/lib/plexmediaserver ./plexbin              # lsio, plexinc, binhex
#   docker cp plex:/app/bin/usr/lib/plexmediaserver ./plexbin      # hotio
#
# Not sure which you have?
#   docker exec plex sh -c "find / -xdev -type f -name 'Plex SQLite' 2>/dev/null"
PLEX_SQLITE_DIR=./plexbin

# ─── Ownership and time ──────────────────────────────────────────────────────

# Ownership for pledebe's /data directory. Unraid appdata is normally
# nobody:users, which is 99:100. Most other systems want 1000:1000.
PUID=99
PGID=100

# Affects the deep-check schedule and the times shown on the page.
TZ=Europe/London

# ─── Backup checking (optional but recommended) ──────────────────────────────

# Plex can write database backups anywhere, and records that path in its OWN
# container namespace, which pledebe cannot see. Without this, backup freshness
# is reported as "unknown" — never as a failure.
#
# Find where Plex writes them:
#   docker exec plex sh -c "tr ' ' '\n' < /config/Preferences.xml | grep -i butlerdatabase"
#
# Then map the matching HOST directory here, uncomment the /plexbackups volume
# in docker-compose.yml, and set PLEX_BACKUP_DIR below.
#PLEX_BACKUP=/mnt/user/backup/plex/Databases
#PLEX_BACKUP_DIR=/plexbackups

# ─── Authentication (strongly recommended if not on a trusted LAN) ───────────

# The page exposes your Plex file paths and database details, and has a button
# that makes the server read your entire database. Set both to enable HTTP basic
# auth. pledebe logs a warning at startup if it listens on all interfaces with
# neither of these set.
#
# Never port-forward pledebe, with or without a password.
#PLEDEBE_USER=admin
#PLEDEBE_PASSWORD=change-me

# ─── Scheduling and retention ────────────────────────────────────────────────

# How often the cheap checks run.
#SCAN_INTERVAL=15m

# Hour of day (0-23) for the daily integrity check. Pick a quiet hour, ideally
# outside Plex's own maintenance window.
#DEEP_CHECK_HOUR=4

# How long detailed 15-minute samples are kept. Daily summaries are kept
# forever regardless, at roughly 0.8 MB per year.
#PLEDEBE_RETAIN=336h

# ─── Ports ───────────────────────────────────────────────────────────────────
#
# To serve on a different port, change the LEFT side of the ports mapping in
# docker-compose.yml — for example "8087:8080". PLEDEBE_ADDR changes the port
# INSIDE the container and is only useful when running the binary directly.
