# Copy to .env and edit. See docs/platforms.md for platform-specific paths.

# The Plex config root — the directory containing "Plug-in Support/Databases".
# hotio:        /mnt/user/appdata/plex
# lsio/plexinc: /mnt/user/appdata/plex/Library/Application Support/Plex Media Server
PLEX_CONFIG=/mnt/user/appdata/plex

# Where Plex's SQLite binary and its sibling files live, extracted with:
#   docker cp plex:/usr/lib/plexmediaserver ./plexbin           # lsio, plexinc
#   docker cp plex:/app/bin/usr/lib/plexmediaserver ./plexbin   # hotio
PLEX_SQLITE_DIR=./plexbin

# OPTIONAL: the host directory PMS writes database backups to. Check
# ButlerDatabaseBackupPath in Preferences.xml — it is a path inside the PMS
# container, so find the matching host path with:
#   docker inspect plex --format '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{"\n"}}{{end}}'
# Uncomment the matching volume line in docker-compose.yml as well.
#PLEX_BACKUP=/mnt/user/backup/plex/Databases
#PLEX_BACKUP_DIR=/plexbackups

TZ=Europe/London
